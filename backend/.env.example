# ==============================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================

# Server Port (Auto-assigned by Render/Railway or defaults to 5001)
PORT=5001
NODE_ENV=production

# Database (MongoDB Atlas Connection URI)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/fashion?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/fashion?retryWrites=true&w=majority

# JWT Secrets for Multi-Role Auth
JWT_SECRET_ADMIN=adminsupersecretkey_change_in_production
JWT_SECRET_CUSTOMER=customersupersecretkey_change_in_production
JWT_SECRET_VENDOR=vendorsupersecretkey_change_in_production
JWT_EXPIRE=1d

# Refresh Token
REFRESH_SECRET=refreshsecretkey_change_in_production
REFRESH_EXPIRE=7d

# Frontend Client URL for CORS (Comma-separated for multiple domains)
# Example: https://fashion-frontend.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173,http://localhost:3000

# File Uploads
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5000000

# Auction Timing & Bidding Defaults
MIN_BID_INCREMENT=10
AUCTION_BUFFER_TIME=30
BCRYPT_SALT=10
