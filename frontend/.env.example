# ==============================================
# FRONTEND ENVIRONMENT CONFIGURATION (PRODUCTION / HOSTING)
# ==============================================

# Backend API Base URL (with /api suffix)
# When hosted on Render/Railway/VPS, set to your production backend URL:
# Example: VITE_API_BASE_URL=https://fashion-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5001/api

# API Request Timeout (in milliseconds, 30000 = 30 seconds for cloud cold starts)
VITE_API_TIMEOUT=30000
